{
  "version": "2.0.0",
  "inputs": [],
  "tasks": [
    {
      "label": "ESC 1 · 烧录（不转）",
      "detail": "编译 → 归档 firmware/<分支>.bin → 收油 → 烧录校验 → reset。不给油，电机不转。",
      "type": "shell",
      "command": "bash '${workspaceFolder}/tools/esc-lab.sh' flash",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "ESC_YES": "1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "ESC 2 · 烧录 + 分支脚本（本分支要干什么由脚本决定）",
      "detail": "烧录后自动运行 tools/branch/<分支名>.py；脚本自己决定采集/校准/给油/存 flash，并把结果写 firmware/<分支>.cal.json。无脚本则只烧录。",
      "type": "shell",
      "command": "bash '${workspaceFolder}/tools/esc-lab.sh' flash-ext",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "ESC_YES": "1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}